tag: terminal
-

roscd: "roscd "

roscore:
    "roscore"
    key(enter)

rosdep install:
    "rosdep install --from-paths src --ignore-src -r -y"

rqt graph:
    "rqt_graph"
    key(enter)

vcs import:
    "vcs import --recursive --input "

vcs pull:
    "vcs pull "

vcs status:
    "vcs status \n"

