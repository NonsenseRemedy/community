app: anki
-
# shortcuts from homescreen
# (note: the hover text indicates capitalized, but only lower case works.)
# Press escape to exit out of any of these dialogues
decks | anki decks: key(d)
anki add: key(a)
browse | anki browse: key(b)
anki stats: key(t)
anki sync: key(y)
# available in the decks view
import file: key(cmd-shift-i)
# available in the deck finished screen
anki options: key(o)
custom study: key(c)

# For now, I can use tab to switch between the decks.
# I think I saw a snippet somewhere that let you choose it by name

# shortcuts for adding cards
change note type: key(cmd-n)
change note deck: key(cmd-d)
add tag: key(cmd-shift-t)
add note: key(cmd-enter)


# Unfortunately, there don't appear to be many shortcuts in the browse view
preview: key(cmd-shift-p)
# Once previewing, there are few commands in that view
replay audio: key(r)
back side only: key(b)
last: key(left)
next: key(right)



# commands for reviewing cards
# When reviewing cards, "Browse" will take you to the card currently shown,
# so there is no need for an edit button
show: key(space)
again: key(1)
hard: key(2)
good: key(3)
easy: key(4)
info: key(i)
